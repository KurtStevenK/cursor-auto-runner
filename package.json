{
  "name": "cursor-auto-runner",
  "productName": "Cursor Auto Runner",
  "version": "1.2.2",
  "description": "System-tray app that automatically clicks the Run / Always Run button in the Cursor IDE and tracks click statistics.",
  "main": "dist/src/main/main.js",
  "license": "MIT",
  "author": "Cursor Auto Runner contributors",
  "repository": {
    "type": "git",
    "url": ""
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json && tsc -p tsconfig.overlay.json && node scripts/copy-overlay-assets.js",
    "start": "npm run compile && electron .",
    "generate:icons": "node scripts/generate-icons.js",
    "capture-templates": "npm run compile && electron dist/scripts/capture-templates.js",
    "prepack": "npm run compile",
    "predist": "npm run compile",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "rebuild:dev": "electron-rebuild -f -w better-sqlite3 -a x64"
  },
  "build": {
    "appId": "com.gf-elektro.cursor-auto-runner",
    "productName": "Cursor Auto Runner",
    "directories": { "output": "release" },
    "files": ["dist/**", "assets/**", "package.json"],
    "asarUnpack": ["**/node_modules/better-sqlite3/**", "**/node_modules/@nut-tree-fork/**"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64", "arm64"] }],
      "icon": "assets/icons/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "assets/icons/icon.png",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Cursor Auto Runner watches the screen to find the Run button in your Cursor IDE window.",
        "NSAccessibilityUsageDescription": "Cursor Auto Runner needs accessibility access to click the Run button for you."
      }
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icons",
      "category": "Utility"
    }
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  }
}
