rules_version = '2';
// Public read for published Linux release binaries only.
service firebase.storage {
  match /b/{bucket}/o {
    match /linux/{version}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /releases/{version}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
